PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Scheduler / throttling (all configurable, nothing hardcoded)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
SENDER_COUNT=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional: set only if Slack rejects http://localhost (use an https ngrok URL)
# SLACK_REDIRECT_URI=https://xxxx.ngrok-free.app/auth/slack/callback

# --- Optional: send REAL emails instead of Ethereal (fake SMTP) ---
# Leave SMTP_HOST empty to keep using Ethereal. Fill all of these to use a real provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=youraddress@gmail.com
